require 'dotenv'
require_relative 'update_version_and_release'
Dotenv.load

default_platform(:android)

platform :android do
  desc "Distribute build with user prompt for version and release note"
  lane :firebase_distribution do
    
    new_version = auto_increment_version
    UI.message("🔢 Auto-updated to version: #{new_version}")

    new_note = UI.input("📝 Enter release note:")
    update_fastfile_release_note(new_note)

    sh "flutter build apk --no-tree-shake-icons"

    firebase_app_distribution(
      app: "1:620508569570:android:7314a2a39e5a8e809ce3bb",
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-release.apk",
      testers: "salafydawah2020@gmail.com",
      release_notes: new_note,
      upload_timeout: 18000
    )
  end
end
